# Security headers for Cloudflare Pages (applies to every deploy: main and the previews).
# Scripts aren't locked down with a CSP script-src because Cloudflare injects its own
# inline bot-detection snippet; everything else that's safe to pin is pinned here.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests

# fonts, models and built assets never change under the same name
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# the moderation page holds the admin secret while it's open: nothing runs on it but its own script
/letters-admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
/letters-admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
/letters-admin.js
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
# the resume opens in the browser's own viewer under a proper name, and a new
# upload shows within minutes; kept out of search results
/resume.pdf
  Content-Disposition: inline; filename="Tejal-Goyal-Resume.pdf"
  Cache-Control: public, max-age=300, must-revalidate
  X-Robots-Tag: noindex
